# ─────────────────────────────────────────────────────────────
# 研策 · Yancec — 环境变量模板
# 用法：cp .env.example .env  然后填入自己的 Key。
# 不填也能启动：系统会进入「离线演示模式」，并在报告头部说明哪一层没有跑成。
# ─────────────────────────────────────────────────────────────

# ---- 主模型（通义千问 / 百炼，OpenAI 兼容协议）----
# 控制台：https://bailian.console.aliyun.com  → API-KEY 管理
DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
QWEN_VL_MODEL=qwen-vl-plus

# ---- 备用模型（千问不可用时的降级通道）----
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---- 质检用模型（建议用更便宜的档位）----
QUALITY_MODEL=deepseek-chat

# ---- 检索通道（三条生命周期独立的通道，任一可用即可）----
# 1) 博查 Web Search API（需 key）
BOCHA_API_KEY=
# 2) Bing 结果页解析（无 key，作为兜底；注意滑窗配额与礼貌间隔）
BING_SCRAPE_MAX=30
BING_SCRAPE_GAP=1.2
# 3) 其他可选通道
SERPAPI_KEY=
BAIDU_API_KEY=

# ---- 应用 ----
DEBUG=true
HOST=127.0.0.1
PORT=8000

# ---- 数据存储 ----
DATABASE_URL=sqlite:///./yancec.db
VECTOR_DB_PATH=./backend/data/chroma

# ---- 权威源直取（巨潮 / 国家统计局 / SEC EDGAR / 世界银行 / IMF …）----
# 总开关：置 0 可一键关闭，接入点静默降级，不影响主流程。
AUTHORITY_FETCH_ENABLED=1
# 每个研究维度期望至少 N 条 L1/L2 证据；不足只告警，不改写结论。
AUTH_QUOTA_PER_DIM=2
# SEC fair-access 政策要求 User-Agent 带真实可达邮箱，请自行填写。
SEC_UA_CONTACT=
# 全报告门户/财经媒体/社媒类引用占比上限（0–1）。
CITATION_MEDIA_RATIO=0.5

# ---- 离线自测开关（由 selftest.py 自动设置，通常无需手填）----
# YANCEC_OFFLINE=1
